# Auto detect text files and normalize line endings
* text=auto

# Force LF for POSIX files
*.sh text eol=lf
*.md text eol=lf
*.py text eol=lf

# Use CRLF for Windows batch and PowerShell
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.exe binary
*.dll binary
*.zip binary
*.png binary
*.jpg binary

graphify-out/graph.json merge=graphify

# Welcome landing media
*.mp4 filter=lfs diff=lfs merge=lfs -text
# The cinematic cut must stay a regular blob (GitHub Pages serves LFS pointers)
docs/welcome/assets/videos/Argus_Cinematic_Showcase.mp4 -filter=lfs -diff=lfs -merge=lfs -text
