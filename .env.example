# --- ARGUS CONFIGURATION ---
# Target WSL Distribution
WSL_DISTRO=kali-linux

# SSH Connection Details
WSL_HOST=127.0.0.1
WSL_PORT=22
WSL_USER=kali
WSL_PASS=kali

# AI Settings
OLLAMA_HOST=http://localhost:11434
SELECTED_MODEL=WhiteRabbitNeo/WhiteRabbitNeo-V3-7B

# --- Streamlit / Launcher overrides (add to .env to override LAUNCH_STUDIO defaults) ---
# Path to the python executable in the Argus virtual environment (relative to scripts\)
VENV_PY=..\Argus_venv\Scripts\python.exe
# Path to the streamlit entrypoint (relative to scripts\)
GUI_ENTRY=..\app\GUI\gui_app.py
# Streamlit server settings
STREAMLIT_PORT=8501
STREAMLIT_HOST=localhost
# Logging / silence flags
TRANSFORMERS_VERBOSITY=error
STREAM_LOG_LEVEL=error
PYTHONWARNINGS=ignore
