# --- ARGUS CONFIGURATION ---
# Target WSL Distribution
WSL_DISTRO=kali-linux

# SSH Connection Details
# Hardening (ARG-02/07): set WSL_KEY_PATH to a private key whose public
# half is installed in Kali's authorized_keys, and WSL_HOST_KEY_SHA256 to
# the server fingerprint from `ssh-keyscan -t ed25519 127.0.0.1` output
# (the SHA256:... field). With a pin set, a mismatching host key aborts.
WSL_HOST=127.0.0.1
WSL_PORT=22
WSL_USER=kali
WSL_PASS=kali

# Studio control-plane password hash (ARG-01). Generate with:
#   python scripts/set_panel_password.py
ARGUS_PANEL_PASSWORD_HASH=

# AI Settings
OLLAMA_HOST=http://localhost:11434
SELECTED_MODEL=hf.co/bartowski/WhiteRabbitNeo_WhiteRabbitNeo-V3-7B-GGUF:Q5_K_M
