# Argus Security Framework - Environment Configuration
# Copy to .env and fill in your values

# WSL / Kali Linux Bridge
WSL_USER=momen
WSL_PASS=momen
WSL_HOST=127.0.0.1
WSL_PORT=22
WSL_DISTRO=kali-linux

# Ollama AI Engine
OLLAMA_HOST=http://localhost:11434
SELECTED_MODEL=WhiteRabbitNeo/WhiteRabbitNeo-V3-7B:latest

# Optional: OpenRouter API (for multi-agent RAG workflow)
# OPENROUTER_API_KEY=your_key_here
